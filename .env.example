# Database
# Docker Compose: DB_HOST=postgres, REDIS_URL=redis://redis:6379/0
# Локальный backend (./scripts/dev-local.sh): DB_HOST=localhost, скрипт подставит URL сам
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=postgres
DB_PORT=5432
DB_NAME=content_platform
DATABASE_URL=postgresql+asyncpg://postgres:your_password@postgres:5432/content_platform
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:your_password@postgres:5432/content_platform

# Redis
REDIS_URL=redis://redis:6379/0

# DeepSeek API — ключ с https://platform.deepseek.com (не оставляйте sk-...)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-chat

# Tavily (веб-поиск для режима «Статьи») — https://tavily.com
# Доп. ключи и автопереключение при лимите — в панели /settings (AI и API)
TAVILY_API_KEY=

# Telegraph (полный текст статей; опционально — создаётся автоматически)
TELEGRAPH_ACCESS_TOKEN=

# OpenAI (optional, fallback DALL-E если Qwen недоступен)
OPENAI_API_KEY=
# Admin key для расходов в панели (не для генерации): platform.openai.com → Admin keys
OPENAI_ADMIN_API_KEY=

# OpenRouter (анимация открыток через Grok Imagine Video)
OPENROUTER_API_KEY=

# Qwen-Image (DashScope) — генерация обложек для постов и статей
# Ключ: https://www.alibabacloud.com/help/en/model-studio/get-api-key
# Singapore (intl): dashscope-intl.aliyuncs.com | Beijing: dashscope.aliyuncs.com
QWEN_IMAGE_API_KEY=
QWEN_IMAGE_API_BASE=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_IMAGE_MODEL=qwen-image-2.0
# Цепочка fallback (через запятую или с новой строки). Первая доступная модель побеждает.
# Можно переопределить в панели: Настройки → Генерация обложек.
QWEN_IMAGE_MODELS=qwen-image-plus,qwen-image-max,qwen-image,qwen-image-2.0-pro,qwen-image-2.0,z-image-turbo
QWEN_IMAGE_EDIT_MODELS=qwen-image-edit-plus,qwen-image-edit-max,qwen-image-edit
QWEN_IMAGE_SIZE=1024*1024

# Telegram Bot (publishing)
TELEGRAM_BOT_TOKEN=

# Telegram Userbot (Telethon parsing)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+7...

# VK API (группы / сообщества)
VK_ACCESS_TOKEN=

# MAX Bot API — токен бота после модерации на business.max.ru
MAX_BOT_TOKEN=
# Базовый URL Bot API MAX (с 19.07.2025 — platform-api2.max.ru)
MAX_API_BASE=https://platform-api2.max.ru
# Путь к PEM-бандлу CA Минцифры. Пусто = встроенный
# app/infrastructure/certs/russian_trusted_ca.pem
MAX_CA_BUNDLE=

# Alert bot (owner notifications)
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=

# App / вход в панель (http://127.0.0.1:8080 или :5173)
SECRET_KEY=change_me_use_at_least_32_random_chars_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production
DEBUG=false
LOG_LEVEL=INFO

# Production: домен панели для CORS (через запятую)
# CORS_ORIGINS=https://panel.example.com

# Хранение данных в PostgreSQL (дней); время очистки — в настройках панели (UTC)
RETENTION_DAYS=30
# Парсинг: запасной лимит, если в панели не задан fetch_max_age_days
FETCH_MAX_AGE_DAYS=1
