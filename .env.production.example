# Production environment for VPS / Dokploy
# Copy to .env on the server and fill all secrets.
# Generate SECRET_KEY: openssl rand -hex 32
# Generate DB_PASSWORD: openssl rand -base64 24

# ── Database (Docker service names) ──────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_HOST=postgres
DB_PORT=5432
DB_NAME=content_platform
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/content_platform
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/content_platform

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Public URL (для CORS; HTTPS после настройки домена в Dokploy) ────────────
CORS_ORIGINS=https://panel.yourdomain.com

# ── DeepSeek API ─────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-chat

# ── Tavily (веб-поиск для статей) ────────────────────────────────────────────
TAVILY_API_KEY=

# ── Telegraph ────────────────────────────────────────────────────────────────
TELEGRAPH_ACCESS_TOKEN=

# ── OpenAI (fallback DALL-E) ─────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Qwen-Image (обложки) ─────────────────────────────────────────────────────
QWEN_IMAGE_API_KEY=
QWEN_IMAGE_API_BASE=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_IMAGE_MODEL=qwen-image-2.0
QWEN_IMAGE_MODELS=qwen-image-plus,qwen-image-max,qwen-image,qwen-image-2.0-pro,qwen-image-2.0,z-image-turbo
QWEN_IMAGE_EDIT_MODELS=qwen-image-edit-plus,qwen-image-edit-max,qwen-image-edit
QWEN_IMAGE_SIZE=1024*1024

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# ── VK ───────────────────────────────────────────────────────────────────────
VK_ACCESS_TOKEN=

# ── MAX ──────────────────────────────────────────────────────────────────────
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru
MAX_CA_BUNDLE=

# ── Alert bot ────────────────────────────────────────────────────────────────
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=

# ── App security ─────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
DEBUG=false
LOG_LEVEL=INFO

# ── Retention ────────────────────────────────────────────────────────────────
RETENTION_DAYS=30
FETCH_MAX_AGE_DAYS=1

# ── Dokploy only (optional) ──────────────────────────────────────────────────
# HTTP_PORT=80
